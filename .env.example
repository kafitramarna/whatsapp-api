# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=whatsapp_api
DB_USER=root
DB_PASS=your_password_here

# Security
# Comma-separated list of allowed CORS origins. Leave empty to allow all in dev / block all in prod.
CORS_ORIGINS=
# Set to true to allow public user registration via /auth/register. false = admin-only registration.
PUBLIC_REGISTRATION=false

# Logging
LOG_LEVEL=info

# WhatsApp Configuration
WA_RECONNECT_INTERVAL=5000
WA_MAX_RECONNECT_RETRIES=5
